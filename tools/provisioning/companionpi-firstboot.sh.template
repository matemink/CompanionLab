#!/bin/bash

set -euo pipefail

readonly TARGET_HOSTNAME="companionpi"
readonly TARGET_USER="companion"
readonly PASSWORD_HASH='__PASSWORD_HASH__'

decode() {
    printf '%s' "$1" | base64 --decode
}

WIFI_SSID="$(decode '__WIFI_SSID_BASE64__')"
WIFI_PASSWORD="$(decode '__WIFI_PASSWORD_BASE64__')"
SSH_PUBLIC_KEY="$(decode '__SSH_PUBLIC_KEY_BASE64__')"

if [ -x /usr/lib/raspberrypi-sys-mods/imager_custom ]; then
    /usr/lib/raspberrypi-sys-mods/imager_custom set_hostname "$TARGET_HOSTNAME"
else
    current_hostname="$(tr -d ' \t\n\r' </etc/hostname)"
    printf '%s\n' "$TARGET_HOSTNAME" >/etc/hostname
    sed -i "s/127.0.1.1.*${current_hostname}/127.0.1.1\t${TARGET_HOSTNAME}/" /etc/hosts
fi

if [ -x /usr/lib/userconf-pi/userconf ]; then
    /usr/lib/userconf-pi/userconf "$TARGET_USER" "$PASSWORD_HASH"
elif ! id "$TARGET_USER" >/dev/null 2>&1; then
    useradd --create-home --shell /bin/bash "$TARGET_USER"
    printf '%s:%s\n' "$TARGET_USER" "$PASSWORD_HASH" | chpasswd --encrypted
fi

for group in adm dialout audio netdev video plugdev input gpio spi i2c render sudo; do
    getent group "$group" >/dev/null 2>&1 && usermod --append --groups "$group" "$TARGET_USER"
done

user_home="$(getent passwd "$TARGET_USER" | cut -d: -f6)"
install -d -m 700 -o "$TARGET_USER" -g "$TARGET_USER" "$user_home/.ssh"
printf '%s\n' "$SSH_PUBLIC_KEY" >"$user_home/.ssh/authorized_keys"
chown "$TARGET_USER:$TARGET_USER" "$user_home/.ssh/authorized_keys"
chmod 600 "$user_home/.ssh/authorized_keys"

install -d -m 755 /etc/ssh/sshd_config.d
cat >/etc/ssh/sshd_config.d/99-companionlab.conf <<'EOF'
PubkeyAuthentication yes
PasswordAuthentication no
KbdInteractiveAuthentication no
EOF

printf '%s ALL=(ALL:ALL) NOPASSWD: ALL\n' "$TARGET_USER" >/etc/sudoers.d/90-companionlab
chmod 440 /etc/sudoers.d/90-companionlab

if [ -x /usr/lib/raspberrypi-sys-mods/imager_custom ]; then
    /usr/lib/raspberrypi-sys-mods/imager_custom enable_ssh -k "$SSH_PUBLIC_KEY"
    /usr/lib/raspberrypi-sys-mods/imager_custom set_wlan "$WIFI_SSID" "$WIFI_PASSWORD" "UA"
else
    systemctl enable ssh
    nmcli radio wifi on
    nmcli connection delete companionlab-wifi >/dev/null 2>&1 || true
    nmcli connection add type wifi ifname wlan0 con-name companionlab-wifi ssid "$WIFI_SSID"
    nmcli connection modify companionlab-wifi wifi-sec.key-mgmt wpa-psk wifi-sec.psk "$WIFI_PASSWORD"
    nmcli connection modify companionlab-wifi connection.autoconnect yes
fi

timedatectl set-timezone Europe/Kyiv

rm -f /boot/firstrun.sh /boot/firmware/firstrun.sh
sed -i 's| systemd.run[^ ]*||g; s| systemd.run_success_action[^ ]*||g; s| systemd.unit=kernel-command-line.target||g' \
    /boot/cmdline.txt /boot/firmware/cmdline.txt 2>/dev/null || true

sync
exit 0
