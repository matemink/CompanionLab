<?xml version="1.0"?>
<sdf version="1.9">
  <model name="iris_with_landing_camera">
    <include>
      <uri>model://iris_with_gimbal</uri>
      <name>vehicle</name>
    </include>

    <link name="landing_camera_link">
      <pose relative_to="vehicle::iris_with_standoffs::base_link">
        0 0 -0.14 0 0 0
      </pose>
      <inertial>
        <mass>0.01</mass>
        <inertia>
          <ixx>0.00001</ixx>
          <iyy>0.00001</iyy>
          <izz>0.00001</izz>
        </inertia>
      </inertial>
      <visual name="landing_camera_body">
        <geometry>
          <box>
            <size>0.05 0.05 0.03</size>
          </box>
        </geometry>
        <material>
          <ambient>0.05 0.12 0.14 1</ambient>
          <diffuse>0.05 0.12 0.14 1</diffuse>
        </material>
      </visual>

      <!-- Gazebo cameras look along sensor +X; +90 deg pitch points it down. -->
      <sensor name="landing_camera" type="camera">
        <pose>0 0 -0.02 0 1.5707963267948966 0</pose>
        <camera>
          <horizontal_fov>2.0</horizontal_fov>
          <image>
            <width>640</width>
            <height>480</height>
          </image>
          <clip>
            <near>0.05</near>
            <far>100</far>
          </clip>
        </camera>
        <always_on>true</always_on>
        <update_rate>30</update_rate>
        <visualize>true</visualize>
        <plugin name="GstCameraPlugin" filename="GstCameraPlugin">
          <udp_host>127.0.0.1</udp_host>
          <udp_port>5601</udp_port>
          <use_basic_pipeline>true</use_basic_pipeline>
          <use_cuda>false</use_cuda>
        </plugin>
      </sensor>
    </link>

    <joint name="landing_camera_joint" type="fixed">
      <parent>vehicle::iris_with_standoffs::base_link</parent>
      <child>landing_camera_link</child>
    </joint>
  </model>
</sdf>
